# Настройки Telegram Video Panel.
#
# Docker Compose:  cp example.env .env   → впишите TVP_PASSWORD → docker compose up -d
# install.sh:      файл /opt/tg-video-panel/.env создаётся автоматически (пароль генерируется).
#
# Файл .env содержит пароль — не публикуйте его (он уже в .gitignore).

# Пароль входа в панель — обязательно. Длинный и случайный, например: openssl rand -base64 18
TVP_PASSWORD=

# Порт панели
TVP_PORT=8765

# Docker Compose: на каком адресе хоста открыть порт.
#   0.0.0.0   — доступ по IP из интернета (http://IP-сервера:8765)
#   127.0.0.1 — только с самого сервера (за обратным прокси с HTTPS или через SSH-туннель)
TVP_BIND=0.0.0.0

# Адреса обратных прокси, которым доверять заголовки X-Forwarded-* (через запятую).
# Для Docker за прокси на хосте укажите адрес шлюза Docker, например 172.17.0.1
TVP_FORWARDED_ALLOW_IPS=127.0.0.1

# ----- Ниже — для установки без Docker (install.sh заполняет и поддерживает сам) -----

# Серверный режим: вход по паролю, видео только внутри TVP_DOWNLOAD_DIR
TVP_SERVER=1
# Адрес, на котором слушает панель: 0.0.0.0 — все интерфейсы, 127.0.0.1 — только локально
TVP_HOST=127.0.0.1
# Настройки, вход в Telegram, задания
TVP_DATA_DIR=/opt/tg-video-panel/data
# Скачанные видео
TVP_DOWNLOAD_DIR=/opt/tg-video-panel/videos
